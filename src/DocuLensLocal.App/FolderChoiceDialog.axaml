<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DocuLensLocal.App.FolderChoiceDialog"
        Width="480"
        MinWidth="360"
        Height="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}">
    <Border Margin="16" Classes="card" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}"
                           TextWrapping="Wrap"
                           Text="빼 둘 폴더"/>
                <TextBlock Margin="0,12,0,0"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="목록에서 빼면 그 폴더 파일은 검색에서 빠집니다. 원본 파일은 그대로입니다."/>
            </StackPanel>
            <ListBox x:Name="FolderList"
                     Grid.Row="1"
                     Margin="0,16,0,0"/>
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button x:Name="SecondaryButton"
                        Classes="secondary"
                        Content="취소"
                        MinWidth="88"
                        Click="SecondaryButton_OnClick"/>
                <Button x:Name="PrimaryButton"
                        Classes="primary"
                        Content="빼기"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Click="PrimaryButton_OnClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
