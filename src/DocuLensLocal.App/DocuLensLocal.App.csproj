<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DocuLensLocal</AssemblyName>
    <RootNamespace>DocuLensLocal.App</RootNamespace>
    <Version>0.1.0</Version>
    <Product>DocuLens Local</Product>
    <StartupObject>DocuLensLocal.App.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocuLensLocal.Core\DocuLensLocal.Core.csproj" />
  </ItemGroup>

</Project>
