<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:DocuLensLocal.App"
        x:Class="DocuLensLocal.App.MainWindow"
        Title="DocuLens Local"
        Height="680"
        Width="840"
        MinHeight="520"
        MinWidth="720"
        Background="{StaticResource PageBrush}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,8,16">
            <RadioButton x:Name="SearchTab"
                         Classes="navtab"
                         Content="검색"
                         GroupName="MainNav"
                         IsChecked="True"
                         IsCheckedChanged="NavTab_OnIsCheckedChanged"/>
            <RadioButton x:Name="InfoTab"
                         Classes="navtab"
                         Content="정보"
                         GroupName="MainNav"
                         Margin="20,0,0,0"
                         IsCheckedChanged="NavTab_OnIsCheckedChanged"/>
        </StackPanel>

        <Border Grid.Row="1" Classes="card">
            <Grid>
                <Grid x:Name="FirstRunPanel">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBrush}"
                                   TextWrapping="Wrap"
                                   Text="인덱싱할 폴더를 선택하세요"/>
                        <TextBlock Margin="0,16,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource TitleBrush}"
                                   TextWrapping="Wrap"
                                   Text="검색할 PDF, Word, 한글(HWP), Excel 파일이 들어 있는 폴더를 선택하세요. 파일 이름만이 아니라 계약서 본문·스캔 OCR 글자까지 이 컴퓨터에서만 찾아 둡니다."/>
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="다른 컴퓨터에서는 폴더 이름과 위치가 다를 수 있습니다. 그 컴퓨터에 있는 문서 폴더를 새로 선택하면 됩니다."/>
                        <TextBlock x:Name="SelectedFolderText"
                                   Margin="0,20,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TitleBrush}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="SelectFolderButton"
                                    Classes="primary"
                                    Content="폴더 선택"
                                    MinWidth="140"
                                    Click="SelectFolderButton_OnClick"/>
                            <Button x:Name="IndexButton"
                                    Classes="secondary"
                                    Content="인덱싱"
                                    MinWidth="140"
                                    Margin="12,0,0,0"
                                    IsEnabled="False"
                                    Click="IndexButton_OnClick"/>
                        </StackPanel>
                        <TextBlock x:Name="IndexCountText" Margin="0,24,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" Text="건수: —"/>
                        <TextBlock x:Name="IndexCurrentFileText" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" Text="현재 파일: —"/>
                        <TextBlock x:Name="IndexStatusText" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" Text="폴더를 선택한 뒤 인덱싱을 누르세요."/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SearchPanel" IsVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Border DockPanel.Dock="Right"
                                Background="{StaticResource ChipBrush}"
                                CornerRadius="12"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                            <TextBlock x:Name="IndexedSummaryText"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ChipTextBrush}"
                                       Text="인덱싱 완료"/>
                        </Border>
                        <StackPanel>
                            <TextBlock FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TitleBrush}"
                                       Text="문서 검색"/>
                            <TextBlock x:Name="IdleHintText"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="파일명이나 본문 단어로 찾아 보세요"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,20,0,0"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="26"
                            Height="52">
                        <DockPanel>
                            <Button x:Name="ResetSearchButton"
                                    DockPanel.Dock="Right"
                                    Classes="ghost"
                                    Content="초기화"
                                    Margin="0,6,8,6"
                                    Click="ResetSearchButton_OnClick"/>
                            <Button x:Name="SearchButton"
                                    DockPanel.Dock="Right"
                                    Classes="primary"
                                    Content="검색"
                                    Margin="4,6,0,6"
                                    MinWidth="88"
                                    Click="SearchButton_OnClick"/>
                            <Border DockPanel.Dock="Left"
                                    Width="36"
                                    Height="36"
                                    Margin="10,0,0,0"
                                    CornerRadius="18"
                                    Background="{StaticResource ChipBrush}"
                                    VerticalAlignment="Center">
                                <Path Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{StaticResource AccentDarkBrush}"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      Data="M 9,9 A 5.5,5.5 0 1 1 9,8.9 M 13.2,13.2 L 17.5,17.5"/>
                            </Border>
                            <TextBox x:Name="SearchQueryBox"
                                     Classes="bare"
                                     Watermark="버스 광고, 부대, 계약…"
                                     VerticalAlignment="Stretch"
                                     KeyDown="SearchQueryBox_OnKeyDown"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Center">
                        <StackPanel x:Name="IdleFormatBadges"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="12">
                            <Button x:Name="PdfFormatButton"
                                    Classes="format pdf"
                                    Width="72"
                                    Height="72"
                                    FontSize="16"
                                    Tag="Pdf"
                                    ToolTip.Tip="PDF 포함/제외"
                                    Content="PDF"
                                    Click="FormatFilterButton_OnClick"/>
                            <Button x:Name="WordFormatButton"
                                    Classes="format word"
                                    Width="72"
                                    Height="72"
                                    FontSize="15"
                                    Tag="Word"
                                    ToolTip.Tip="Word 포함/제외"
                                    Content="WORD"
                                    Click="FormatFilterButton_OnClick"/>
                            <Button x:Name="HangulFormatButton"
                                    Classes="format hwp"
                                    Width="72"
                                    Height="72"
                                    FontSize="16"
                                    Tag="Hangul"
                                    ToolTip.Tip="한글(HWP) 포함/제외"
                                    Content="HWP"
                                    Click="FormatFilterButton_OnClick"/>
                            <Button x:Name="ExcelFormatButton"
                                    Classes="format excel"
                                    Width="72"
                                    Height="72"
                                    FontSize="13"
                                    Tag="Excel"
                                    ToolTip.Tip="Excel 포함/제외"
                                    Content="EXCEL"
                                    Click="FormatFilterButton_OnClick"/>
                        </StackPanel>
                        <TextBlock x:Name="FormatFilterHintText"
                                   Margin="0,10,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource ChipTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="종류를 누른 뒤 검색하면 그 파일만 나옵니다. 여러 개를 함께 누를 수 있습니다"/>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <StackPanel x:Name="IdleHintPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="440">
                            <TextBlock Margin="0,0,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource ChipTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="PDF · Word · 한글(HWP) · Excel 파일을 찾을 수 있습니다"/>
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TitleBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="파일명이나 본문 단어로 찾아 보세요"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="검색하면 근거 문장과 함께 파일이 나타납니다."/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,18,0,0"
                                        Spacing="8">
                                <Button Classes="example"
                                        Content="버스 광고"
                                        Tag="버스 광고"
                                        Click="ExampleChip_OnClick"/>
                                <Button Classes="example"
                                        Content="부대"
                                        Tag="부대"
                                        Click="ExampleChip_OnClick"/>
                                <Button Classes="example"
                                        Content="계약"
                                        Tag="계약"
                                        Click="ExampleChip_OnClick"/>
                            </StackPanel>
                        </StackPanel>

                        <ListBox x:Name="SearchResultsList"
                                 Classes="search"
                                 IsVisible="False"
                                 DoubleTapped="SearchResultsList_OnDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left"
                                                Classes="result-badge"
                                                Classes.pdf="{Binding IsPdf}"
                                                Classes.word="{Binding IsWord}"
                                                Classes.hwp="{Binding IsHangul}"
                                                Classes.excel="{Binding IsExcel}"
                                                Width="40"
                                                Height="40"
                                                CornerRadius="10"
                                                VerticalAlignment="Top"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding KindLabel}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel DockPanel.Dock="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="12,0,0,0"
                                                    Spacing="6">
                                            <Button Classes="primary compact"
                                                    Content="열기"
                                                    Click="OpenResultButton_OnClick"/>
                                            <Button Classes="secondary compact"
                                                    Content="폴더에서 보기"
                                                    Click="RevealResultButton_OnClick"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right"
                                                        Background="{StaticResource ChipBrush}"
                                                        CornerRadius="8"
                                                        Padding="8,3"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource ChipTextBrush}"
                                                               Text="{Binding MatchLabel}"/>
                                                </Border>
                                                <app:HighlightedTextBlock FontWeight="SemiBold"
                                                                           FontSize="14"
                                                                           Foreground="{StaticResource TitleBrush}"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Spans="{Binding FileNameSpans}"/>
                                            </DockPanel>
                                            <app:HighlightedTextBlock Margin="0,4,0,0"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource TitleBrush}"
                                                                       TextWrapping="Wrap"
                                                                       IsVisible="{Binding HasSnippet}"
                                                                       Spans="{Binding SnippetSpans}"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding LocationLine}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="EmptyHintPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420"
                                    IsVisible="False">
                            <TextBlock x:Name="SearchEmptyText"
                                       FontSize="14"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Text="검색 결과가 없습니다."/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="True">
                        <Button x:Name="ChangeFolderButton"
                                DockPanel.Dock="Left"
                                Classes="secondary"
                                Content="폴더 변경"
                                Click="ChangeFolderButton_OnClick"/>
                        <Button x:Name="SyncIndexButton"
                                DockPanel.Dock="Left"
                                Classes="secondary"
                                Margin="8,0,0,0"
                                Content="새 파일 인덱싱"
                                Click="SyncIndexButton_OnClick"/>
                        <Button x:Name="RebuildIndexButton"
                                DockPanel.Dock="Left"
                                Classes="secondary"
                                Margin="8,0,0,0"
                                Content="처음부터 다시 인덱싱"
                                Click="RebuildIndexButton_OnClick"/>
                        <TextBlock x:Name="IndexedFolderText"
                                   Margin="16,0,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"/>
                    </DockPanel>
                </Grid>

                <Grid x:Name="InfoPanel" IsVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="ProductNameText"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TitleBrush}"
                                   Text="DocuLens Local"/>
                        <Border Margin="0,12,0,0"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="14"
                                Padding="12,5"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="VersionText"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="버전"/>
                        </Border>
                        <Border Margin="0,20,0,0"
                                Height="1"
                                Background="{StaticResource LineBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,20,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource TitleBrush}"
                                       Text="버전 히스토리"/>
                            <ItemsControl x:Name="VersionHistoryList" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,16" MinHeight="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Width="2"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Stretch"
                                                       Fill="{StaticResource AccentBrush}"
                                                       Margin="0,8,0,-16"
                                                       IsVisible="{Binding !IsLast}"/>
                                            <Ellipse Width="12"
                                                     Height="12"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Top"
                                                     Margin="0,2,0,0"
                                                     Stroke="{StaticResource AccentBrush}"
                                                     StrokeThickness="2"
                                                     Fill="White"
                                                     Classes.current="{Binding IsCurrent}"/>
                                            <Border Grid.Column="1"
                                                    Background="{StaticResource VersionChipBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    VerticalAlignment="Top"
                                                    Margin="12,0,12,0">
                                                <TextBlock FontSize="12"
                                                           Foreground="{StaticResource VersionChipTextBrush}"
                                                           Text="{Binding Version}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Top"
                                                       Margin="0,2,0,0"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TitleBrush}"
                                                       Text="{Binding SummaryKo}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button x:Name="UpdateButton"
                                Classes="primary fullwidth"
                                Content="업데이트"
                                Click="UpdateButton_OnClick"/>
                        <TextBlock x:Name="UpdateStatusText"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="GitHub Releases에서 새 버전을 확인합니다."/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
