<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DocuLensLocal.App.MessageDialog"
        Width="440"
        MinWidth="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}">
    <Border Margin="16" Classes="card" Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}"
                       TextWrapping="Wrap"
                       Text="알림"/>
            <ScrollViewer Margin="0,12,0,0"
                          MaxHeight="280"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="BodyText"
                           FontSize="14"
                           Foreground="{StaticResource TitleBrush}"
                           TextWrapping="Wrap"
                           Text=""/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button x:Name="SecondaryButton"
                        Classes="secondary"
                        Content="나중에"
                        MinWidth="88"
                        Click="SecondaryButton_OnClick"/>
                <Button x:Name="PrimaryButton"
                        Classes="primary"
                        Content="확인"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Click="PrimaryButton_OnClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
