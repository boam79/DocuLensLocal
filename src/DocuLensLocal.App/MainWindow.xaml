<Window x:Class="DocuLensLocal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocuLens Local"
        Height="560"
        Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid x:Name="FirstRunPanel" Margin="32">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="인덱싱할 폴더를 선택하세요" />
                <TextBlock Margin="0,16,0,0" FontSize="14" TextWrapping="Wrap"
                           Text="검색할 PDF가 들어 있는 폴더를 선택하세요. 이 컴퓨터의 폴더 이름은 ‘계약서’가 아니어도 됩니다." />
                <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="#555" TextWrapping="Wrap"
                           Text="다른 컴퓨터에서는 폴더 이름과 위치가 다를 수 있습니다. 그 컴퓨터에 있는 PDF 폴더를 새로 선택하면 됩니다." />
                <TextBlock x:Name="SelectedFolderText" Margin="0,20,0,0" FontSize="13" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="SelectFolderButton"
                            Content="폴더 선택"
                            Width="140"
                            Height="32"
                            HorizontalAlignment="Left"
                            Click="SelectFolderButton_OnClick" />
                    <Button x:Name="IndexButton"
                            Content="인덱싱"
                            Width="140"
                            Height="32"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Click="IndexButton_OnClick" />
                </StackPanel>
                <TextBlock x:Name="IndexCountText" Margin="0,24,0,0" FontSize="13" Text="건수: —" />
                <TextBlock x:Name="IndexCurrentFileText" Margin="0,8,0,0" FontSize="13" Text="현재 파일: —" />
                <TextBlock x:Name="IndexStatusText" Margin="0,8,0,0" FontSize="13" Text="폴더를 선택한 뒤 인덱싱을 누르세요." />
            </StackPanel>
        </Grid>

        <Grid x:Name="SearchPanel" Margin="24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="문서 검색" />
                <TextBlock x:Name="IndexedSummaryText"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="#555"
                           Text="인덱싱 완료" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchQueryBox"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         FontSize="14"
                         KeyDown="SearchQueryBox_OnKeyDown" />
                <Button x:Name="SearchButton"
                        Grid.Column="1"
                        Content="검색"
                        Width="100"
                        Height="32"
                        Margin="8,0,0,0"
                        Click="SearchButton_OnClick" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <ListBox x:Name="SearchResultsList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="#555"
                                           TextWrapping="Wrap"
                                           Text="{Binding FilePath}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="SearchEmptyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#555"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="Collapsed"
                           Text="검색 결과가 없습니다." />
            </Grid>

            <Button x:Name="ChangeFolderButton"
                    Grid.Row="3"
                    Margin="0,16,0,0"
                    Content="폴더 변경 / 다시 인덱싱"
                    Height="32"
                    HorizontalAlignment="Left"
                    Padding="12,0"
                    Click="ChangeFolderButton_OnClick" />
        </Grid>
    </Grid>
</Window>
