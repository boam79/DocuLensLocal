<Window x:Class="DocuLensLocal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocuLens Local"
        Height="640"
        Width="800"
        MinHeight="480"
        MinWidth="640"
        Background="{StaticResource PageBrush}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,8,16">
            <RadioButton x:Name="SearchTab"
                         Style="{StaticResource NavTabStyle}"
                         Content="검색"
                         GroupName="MainNav"
                         IsChecked="True"
                         Checked="NavTab_OnChecked"/>
            <RadioButton x:Name="InfoTab"
                         Style="{StaticResource NavTabStyle}"
                         Content="정보"
                         GroupName="MainNav"
                         Margin="20,0,0,0"
                         Checked="NavTab_OnChecked"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid x:Name="FirstRunPanel">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBrush}"
                                   TextWrapping="Wrap"
                                   Text="인덱싱할 폴더를 선택하세요"/>
                        <TextBlock Margin="0,16,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource TitleBrush}"
                                   TextWrapping="Wrap"
                                   Text="검색할 PDF가 들어 있는 폴더를 선택하세요. 이 컴퓨터의 폴더 이름은 ‘계약서’가 아니어도 됩니다."/>
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="다른 컴퓨터에서는 폴더 이름과 위치가 다를 수 있습니다. 그 컴퓨터에 있는 PDF 폴더를 새로 선택하면 됩니다."/>
                        <TextBlock x:Name="SelectedFolderText"
                                   Margin="0,20,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TitleBrush}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="SelectFolderButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="폴더 선택"
                                    MinWidth="140"
                                    Click="SelectFolderButton_OnClick"/>
                            <Button x:Name="IndexButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="인덱싱"
                                    MinWidth="140"
                                    Margin="12,0,0,0"
                                    IsEnabled="False"
                                    Click="IndexButton_OnClick"/>
                        </StackPanel>
                        <TextBlock x:Name="IndexCountText" Margin="0,24,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" Text="건수: —"/>
                        <TextBlock x:Name="IndexCurrentFileText" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" Text="현재 파일: —"/>
                        <TextBlock x:Name="IndexStatusText" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" Text="폴더를 선택한 뒤 인덱싱을 누르세요."/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SearchPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBrush}"
                                   Text="문서 검색"/>
                        <Border DockPanel.Dock="Right"
                                Background="{StaticResource ChipBrush}"
                                CornerRadius="12"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="IndexedSummaryText"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ChipTextBrush}"
                                       Text="인덱싱 완료"/>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,18,0,0"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="22"
                            Height="44">
                        <DockPanel>
                            <Button x:Name="SearchButton"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="검색"
                                    Margin="6"
                                    MinWidth="88"
                                    Click="SearchButton_OnClick"/>
                            <TextBox x:Name="SearchQueryBox"
                                     Style="{StaticResource BareTextBox}"
                                     VerticalAlignment="Stretch"
                                     KeyDown="SearchQueryBox_OnKeyDown"/>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <ListBox x:Name="SearchResultsList" Style="{StaticResource SearchListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left"
                                                Width="40"
                                                Height="40"
                                                CornerRadius="10"
                                                Background="{StaticResource ChipBrush}"
                                                VerticalAlignment="Top"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="PDF"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentDarkBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TitleBrush}"
                                                       Text="{Binding FileName}"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding FilePath}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="SearchEmptyText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Visibility="Collapsed"
                                   Text="검색 결과가 없습니다."/>
                    </Grid>

                    <Button x:Name="ChangeFolderButton"
                            Grid.Row="3"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,16,0,0"
                            Content="폴더 변경 / 다시 인덱싱"
                            HorizontalAlignment="Left"
                            Click="ChangeFolderButton_OnClick"/>
                </Grid>

                <Grid x:Name="InfoPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="ProductNameText"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TitleBrush}"
                                   Text="DocuLens Local"/>
                        <Border Margin="0,12,0,0"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="14"
                                Padding="12,5"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="VersionText"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="버전"/>
                        </Border>
                        <Border Margin="0,20,0,0"
                                Height="1"
                                Background="{StaticResource LineBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,20,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource TitleBrush}"
                                       Text="버전 히스토리"/>
                            <ItemsControl x:Name="VersionHistoryList" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,16" MinHeight="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Width="2"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Stretch"
                                                       Fill="{StaticResource AccentBrush}"
                                                       Margin="0,8,0,-16">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                            <Ellipse Width="12"
                                                     Height="12"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Top"
                                                     Margin="0,2,0,0"
                                                     Stroke="{StaticResource AccentBrush}"
                                                     StrokeThickness="2"
                                                     SnapsToDevicePixels="True">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Border Grid.Column="1"
                                                    Background="{StaticResource VersionChipBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    VerticalAlignment="Top"
                                                    Margin="12,0,12,0">
                                                <TextBlock FontSize="12"
                                                           Foreground="{StaticResource VersionChipTextBrush}"
                                                           Text="{Binding Version}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Top"
                                                       Margin="0,2,0,0"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TitleBrush}"
                                                       Text="{Binding SummaryKo}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button x:Name="UpdateButton"
                                Style="{StaticResource FullWidthPrimaryButton}"
                                Content="업데이트"
                                Click="UpdateButton_OnClick"/>
                        <TextBlock x:Name="UpdateStatusText"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="GitHub Releases에서 새 버전을 확인합니다."/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
